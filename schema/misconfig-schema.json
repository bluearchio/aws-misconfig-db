{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aws-misconfig-db/schema/misconfig-schema.json",
  "title": "AWS Misconfiguration Entry",
  "description": "Schema for AWS misconfiguration database entries",
  "type": "object",
  "required": [
    "id",
    "service_name",
    "scenario",
    "risk_detail"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the misconfiguration entry (UUID format)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "service_name": {
      "type": "string",
      "description": "AWS service affected by this misconfiguration",
      "pattern": "^[a-z][a-z0-9-]*$",
      "examples": ["ec2", "rds", "s3", "lambda", "iam", "vpc", "cloudfront", "elb", "alb"]
    },
    "scenario": {
      "type": "string",
      "description": "Brief description of the misconfiguration scenario"
    },
    "alert_criteria": {
      "type": "string",
      "description": "Specific conditions or metrics that trigger this alert"
    },
    "recommendation_action": {
      "type": "string",
      "description": "Recommended action to remediate the misconfiguration"
    },
    "risk_detail": {
      "type": "string",
      "description": "Type of risk associated with this misconfiguration. Can be a single value or comma-separated list of: cost, security, operations, performance, reliability, sustainability",
      "pattern": "^(cost|security|operations|performance|reliability|sustainability)(,\\s*(cost|security|operations|performance|reliability|sustainability))*$"
    },
    "build_priority": {
      "type": "integer",
      "description": "Priority level for addressing this misconfiguration (0-3, where 0 is highest)",
      "minimum": 0,
      "maximum": 3
    },
    "action_value": {
      "type": ["integer", "null"],
      "description": "Value metric for the recommended action",
      "minimum": 0
    },
    "effort_level": {
      "type": ["integer", "null"],
      "description": "Level of effort required to implement the recommendation (1-3)",
      "minimum": 0,
      "maximum": 3
    },
    "risk_value": {
      "type": ["integer", "null"],
      "description": "Severity value of the risk (0-3)",
      "minimum": 0,
      "maximum": 3
    },
    "recommendation_description_detailed": {
      "type": "string",
      "description": "Detailed explanation of the recommendation and its benefits"
    },
    "behavior_title": {
      "type": "string",
      "description": "Optional display title for the behavior represented by this catalog row"
    },
    "finding_title": {
      "type": "string",
      "description": "Optional display title for findings generated from this catalog row"
    },
    "countermeasure_title": {
      "type": "string",
      "description": "Optional display title for the countermeasure represented by this catalog row"
    },
    "pillars": {
      "type": "array",
      "description": "AWS Well-Architected pillars this catalog row maps to",
      "items": {
        "type": "string",
        "enum": [
          "operational_excellence",
          "security",
          "reliability",
          "performance_efficiency",
          "cost_optimization",
          "sustainability"
        ]
      },
      "uniqueItems": true
    },
    "external_refs": {
      "type": "object",
      "description": "External framework references mapped to this catalog row",
      "properties": {
        "well_architected": {
          "description": "AWS Well-Architected best practice IDs",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "attack_technique": {
          "description": "MITRE ATT&CK technique IDs",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "d3fend": {
          "description": "MITRE D3FEND technique IDs",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "cis_aws": {
          "description": "CIS AWS Benchmark control IDs",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "config_rule": {
          "description": "AWS Config managed or custom rule IDs",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "prowler_check": {
          "description": "Prowler check IDs",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "trusted_advisor": {
          "description": "AWS Trusted Advisor check IDs",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "cwe": {
          "description": "CWE IDs",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },
    "category": {
      "type": "string",
      "description": "Category of AWS resource or service type",
      "examples": ["compute", "networking", "database", "storage", "security"]
    },
    "output_notes": {
      "type": "string",
      "description": "Additional output notes, pros and cons"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or context about the misconfiguration"
    },
    "references": {
      "type": "array",
      "description": "Array of reference URLs for documentation and resources",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "maxItems": 10
    },
    "metadata": {
      "type": "object",
      "description": "Metadata about the entry",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the entry was created"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the entry was last updated"
        },
        "contributors": {
          "type": "array",
          "description": "List of contributors who have worked on this entry",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string",
          "description": "Original source of this misconfiguration entry",
          "examples": ["AWS Trusted Advisor", "AWS Well-Architected Framework", "Community Contribution"]
        }
      }
    },
    "tags": {
      "type": "array",
      "description": "Searchable tags for categorization",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cve_references": {
      "type": "array",
      "description": "Related CVE identifiers if applicable",
      "items": {
        "type": "string",
        "pattern": "^CVE-[0-9]{4}-[0-9]+$"
      }
    },
    "compliance_mappings": {
      "type": "array",
      "description": "Compliance frameworks this relates to",
      "items": {
        "type": "string",
        "examples": ["PCI-DSS", "HIPAA", "SOC2", "CIS", "NIST"]
      }
    },
    "detection_methods": {
      "type": "array",
      "description": "Methods to detect this misconfiguration",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "description": "Detection method name",
            "examples": ["AWS Config Rule", "CloudWatch Metric", "CLI Command", "API Call"]
          },
          "details": {
            "type": "string",
            "description": "Specific details or code for detection"
          }
        }
      }
    },
    "remediation_examples": {
      "type": "array",
      "description": "Code examples for remediation",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "examples": ["python", "bash", "terraform", "cloudformation", "aws-cli"]
          },
          "code": {
            "type": "string",
            "description": "Example code for remediation"
          },
          "description": {
            "type": "string",
            "description": "Explanation of what the code does"
          }
        }
      }
    },
    "architectural_patterns": {
      "type": "array",
      "description": "Architectural patterns this misconfiguration relates to or violates (e.g., Circuit Breaker, Cache-Aside, Retry with Backoff)",
      "items": {
        "type": "object",
        "properties": {
          "pattern_name": {
            "type": "string",
            "description": "Name of the architectural pattern",
            "examples": ["Circuit Breaker", "Retry with Exponential Backoff", "Cache-Aside", "Bulkhead", "Throttling", "Queue-Based Load Leveling", "Saga", "Event Sourcing", "Anti-corruption Layer"]
          },
          "relationship": {
            "type": "string",
            "enum": ["missing_implementation", "incorrect_implementation", "anti_pattern", "related_to"],
            "description": "How this misconfiguration relates to the pattern"
          },
          "description": {
            "type": "string",
            "description": "Specific explanation of the pattern relationship to this misconfiguration"
          }
        },
        "required": ["pattern_name", "relationship"]
      }
    },
    "pattern_implementation_guidance": {
      "type": "string",
      "description": "Specific guidance on implementing the architectural pattern to resolve this misconfiguration, including AWS services, configuration steps, and best practices"
    },
    "estimated_cost_impact": {
      "type": "string",
      "description": "Estimated cost impact of this misconfiguration (e.g., '$10-50/month per resource', 'up to $500/month')"
    },
    "compliance_frameworks": {
      "type": "array",
      "description": "Compliance frameworks this recommendation maps to",
      "items": {
        "type": "string",
        "examples": ["CIS", "SOC2", "HIPAA", "PCI-DSS", "NIST-800-53", "ISO-27001", "GDPR", "FedRAMP"]
      },
      "uniqueItems": true
    },
    "aws_doc_url": {
      "type": "string",
      "format": "uri",
      "description": "Canonical AWS documentation URL for this misconfiguration or best practice"
    }
  }
}
